<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The headless phone relay: serves the glasses page and relays the first connection between
    glasses and phones. Cross-platform (Windows, Linux), no tray. It references only relay/, so
    no capture, input, window or media code is in it: nothing here can control the machine it
    runs on (RelayServerIsolationTests checks that).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GlassesRemote.RelayServer</RootNamespace>
    <!-- Linux hosts may be arm64; the repo default (x64) is for the Windows server. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../relay/GlassesRemote.Relay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GlassesRemote.Server.Tests" />
  </ItemGroup>

</Project>
