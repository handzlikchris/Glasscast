{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "relay": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://127.0.0.1:5090",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "Web__ClientRoot": "../client-web/dist"
      }
    },
    "relay-dev": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://127.0.0.1:5090",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Web__ClientRoot": "../client-web/dist"
      }
    }
  }
}
