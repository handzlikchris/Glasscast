<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The phone relay and what it needs, with no Windows, capture, input or media code: the PC
    server and the headless relay server (relay-server/) both use it. Keep it that way: the
    relay server is meant for a box that must never be controllable from the glasses.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GlassesRemote.Server</RootNamespace>
    <!-- Also loaded by the relay server on arm64 Linux hosts. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GlassesRemote.Server" />
    <InternalsVisibleTo Include="GlassesRemote.Server.Tests" />
    <InternalsVisibleTo Include="E2eHarness" />
  </ItemGroup>

</Project>
