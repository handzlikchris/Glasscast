{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SIPSorcery": "Warning"
    }
  },
  "AllowedHosts": "glasses.example.com;localhost;127.0.0.1",
  // Loopback only: Caddy is the only thing that talks to this process.
  "Urls": "http://127.0.0.1:5080",

  "Web": {
    "AllowedOrigins": [ "https://glasses.example.com" ],
    "ClientRoot": "../client-web/dist"
  },

  "Pairing": {
    "RequestTimeout": "00:01:00",
    "TokenUseWindow": "00:00:30",
    "MaxRequestsPerIp": 5,
    "MaxRequestsGlobal": 20,
    "RateWindow": "00:01:00"
  },

  "Session": {
    "AuthTimeout": "00:00:03",
    "IdleTimeout": "01:00:00",
    "MaxDuration": "04:00:00",
    "MaxMessagesPerSecond": 120
  },

  "Media": {
    // Your router's static public IP. Put the real value in appsettings.Local.json (git-ignored)
    // or set the environment variable Media__PublicIp.
    "PublicIp": "",
    // Must be even (SIPSorcery requirement).
    "MediaPort": 50000,
    // LAN IP of the adapter the router forwards MediaPort to. Set it when the PC has more than
    // one network adapter (e.g. Ethernet + Wi-Fi), or replies may leave through the wrong one.
    "BindAddress": "",
    "IncludeLanCandidates": false,
    // "H264" (Windows Media Foundation; falls back to VP8 if missing) or "VP8".
    "Codec": "H264",
    "FramesPerSecond": 20,
    "TargetKbps": 2500,
    "KeyframeIntervalSeconds": 2,
    "FrameWidth": 600,
    "FrameHeight": 600
  }
}
