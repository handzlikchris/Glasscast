{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SIPSorcery": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Spike": {
    // Public IP the browser should send media to (your router's static IP).
    // Leave empty to rely on LAN candidates only.
    "PublicIp": "",
    // UDP port the peer connection binds to; forward it on the router.
    "MediaPort": 50000,
    // Include the PC's LAN addresses as ICE candidates (handy for LAN testing).
    "IncludeLanCandidates": true,
    "FramesPerSecond": 30,
    "TargetKbps": 1500,
    // Hard cap on one spike session, so a stale tab can't hold the media port forever.
    "MaxSessionMinutes": 15
  }
}
