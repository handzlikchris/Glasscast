# Public reverse proxy for the glasses app.
# Run from the repo root:  caddy run --config deploy/Caddyfile
#
# The router forwards external TCP 443 to this PC's port 8443 (IIS keeps 443 locally).
# Caddy listens on 8443 and gets its certificate through the TLS-ALPN challenge, which
# Let's Encrypt sends to public 443 and the router hands to us. No DNS plugin or API key.
# Override the port with the HTTPS_PORT environment variable if needed.
{
	https_port {$HTTPS_PORT:8443}

	# Port 80 isn't forwarded (and IIS holds it locally), so no HTTP->HTTPS redirect listener.
	auto_https disable_redirects
}

glasses.example.com {
	# Certificate over TLS-ALPN on the HTTPS port only; the HTTP challenge would need port 80.
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Allowlist: only the web client, health check and the WebSockets (glasses pair/session,
	# the phone companion app) reach the app.
	# The CSP header is set by the app itself.
	@allowed path / /index.html /favicon.svg /assets/* /health /ws/pair /ws/session /ws/companion
	handle @allowed {
		reverse_proxy 127.0.0.1:5080
	}

	handle {
		respond 404
	}

	# Auth tokens never travel in URLs (they go in the first WebSocket message),
	# so the access log cannot capture them.
	log {
		output file caddy-access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
